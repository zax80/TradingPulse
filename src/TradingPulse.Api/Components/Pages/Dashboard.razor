@page "/"
@rendermode InteractiveServer
@inject IPriceStateRepository PriceStateRepository
@inject IOrderRepository OrderRepository
@inject ITradingRulesRepository TradingRulesRepository
@inject IOrderSubmissionService OrderSubmissionService
@implements IAsyncDisposable

<PageTitle>TradingPulse</PageTitle>

<h1>TradingPulse</h1>
<p class="subtitle">Live dashboard - prices refresh every 2 seconds. For scripted/negative-case testing, use the Postman collection instead.</p>

<section>
    <h2>Latest Prices</h2>
    @if (_prices.Count == 0)
    {
        <p class="hint">No ticks yet - the pricing engine starts producing within a couple of seconds of the app starting.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Symbol</th><th>Bid</th><th>Ask</th><th>Mid</th><th>Spread %</th><th>Updated (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _prices)
                {
                    <tr>
                        <td>@p.Symbol</td>
                        <td>@p.BidPrice.ToString("0.#####")</td>
                        <td>@p.AskPrice.ToString("0.#####")</td>
                        <td>@p.CurrentMarketPrice.ToString("0.#####")</td>
                        <td>@p.SpreadPercent.ToString("0.####")</td>
                        <td>@p.Timestamp.UtcDateTime.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Submit Order</h2>
    <form>
        <div class="field">
            <label for="clientOrderId">Client Order Id</label>
            <input id="clientOrderId" @bind="_orderForm.ClientOrderId" />
        </div>
        <div class="field">
            <label for="symbol">Symbol</label>
            <select id="symbol" @bind="_orderForm.Symbol">
                @foreach (var symbol in KnownSymbols)
                {
                    <option value="@symbol">@symbol</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="side">Side</label>
            <select id="side" @bind="_orderForm.Side">
                <option value="Buy">Buy</option>
                <option value="Sell">Sell</option>
            </select>
        </div>
        <div class="field">
            <label for="price">Price</label>
            <input id="price" type="number" step="any" @bind="_orderForm.Price" />
        </div>
        <div class="field">
            <label for="quantity">Quantity</label>
            <input id="quantity" type="number" step="any" @bind="_orderForm.Quantity" />
        </div>
        <button type="button" @onclick="SubmitOrderAsync" disabled="@_submitting">Submit</button>
    </form>
    @if (_orderMessage is not null)
    {
        <div class="message @(_orderAccepted ? "ok" : "error")">@_orderMessage</div>
    }
    <p class="hint">Price should be within @_currentDeviationThreshold% of the symbol's current mid price, or the price-deviation rule rejects it.</p>
</section>

<section>
    <h2>Recent Orders</h2>
    @if (_orders.Count == 0)
    {
        <p class="hint">No orders yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Time (UTC)</th><th>Symbol</th><th>Side</th><th>Price</th><th>Qty</th><th>Origin</th><th>Status</th><th>Reasons</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _orders)
                {
                    <tr>
                        <td>@entry.Order.SubmittedAt.UtcDateTime.ToString("HH:mm:ss")</td>
                        <td>@entry.Order.Symbol</td>
                        <td>@entry.Order.Side</td>
                        <td>@entry.Order.Price.ToString("0.#####")</td>
                        <td>@entry.Order.Quantity.ToString("0.##")</td>
                        <td>
                            @if (entry.Order.Origin == OrderOrigin.AutoGenerated)
                            {
                                <span class="origin-auto">Auto</span>
                            }
                            else
                            {
                                <span>Manual</span>
                            }
                        </td>
                        <td class="@(entry.Decision.Status == DecisionStatus.Accepted ? "status-accepted" : "status-rejected")">
                            @entry.Decision.Status
                        </td>
                        <td>@string.Join("; ", entry.Decision.RejectionReasons)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Trading Rules</h2>
    <form>
        <div class="field">
            <label for="maxNotional">Max Notional</label>
            <input id="maxNotional" type="number" step="any" @bind="_rulesForm.MaxNotionalPerOrder" />
        </div>
        <div class="field">
            <label for="maxQuantity">Max Quantity</label>
            <input id="maxQuantity" type="number" step="any" @bind="_rulesForm.MaxQuantityPerOrder" />
        </div>
        <div class="field">
            <label for="deviation">Price Deviation %</label>
            <input id="deviation" type="number" step="any" @bind="_rulesForm.PriceDeviationThresholdPercent" />
        </div>
        <div class="field">
            <label for="spreadThreshold">Auto-Trading Spread %</label>
            <input id="spreadThreshold" type="number" step="any" @bind="_rulesForm.AutoTradingSpreadPercentThreshold" />
        </div>
        <div class="field checkbox-field">
            <input id="dupCheck" type="checkbox" @bind="_rulesForm.DuplicateOrderIdCheckEnabled" />
            <label for="dupCheck">Reject duplicate order ids</label>
        </div>
        <div class="field checkbox-field">
            <input id="whitelistEnabled" type="checkbox" @bind="_rulesForm.SymbolWhitelistEnabled" />
            <label for="whitelistEnabled">Enable symbol whitelist</label>
        </div>
        <div class="field">
            <label for="whitelist">Whitelist (comma-separated)</label>
            <input id="whitelist" @bind="_rulesForm.SymbolWhitelistCsv" placeholder="EURUSD, GBPUSD" />
        </div>
        <button type="button" @onclick="SaveRulesAsync" disabled="@_savingRules">Save Rules</button>
    </form>
    @if (_rulesMessage is not null)
    {
        <div class="message ok">@_rulesMessage</div>
    }
</section>

@code {
    // UI convenience only - the API itself accepts any symbol text; this list just
    // matches SimulatedPricingEngine's instruments so the dropdown has real prices to pick from.
    private static readonly string[] KnownSymbols =
    [
        "EURUSD", "GBPUSD", "USDJPY", "USDCHF", "AUDUSD",
        "USDCAD", "NZDUSD", "EURGBP", "EURJPY", "XAUUSD",
    ];

    private List<PriceSnapshot> _prices = [];
    private List<OrderHistoryEntry> _orders = [];
    private OrderFormModel _orderForm = new();
    private RulesFormModel _rulesForm = new();
    private decimal _currentDeviationThreshold;

    private string? _orderMessage;
    private bool _orderAccepted;
    private bool _submitting;

    private string? _rulesMessage;
    private bool _savingRules;

    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        var rules = await TradingRulesRepository.GetCurrentAsync();
        _rulesForm = RulesFormModel.FromDomain(rules);
        _currentDeviationThreshold = rules.PriceDeviationThresholdPercent;

        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed - stop polling.
        }
    }

    private async Task RefreshAsync()
    {
        _prices = [.. (await PriceStateRepository.GetAllLatestAsync()).OrderBy(p => p.Symbol)];
        _orders = [.. await OrderRepository.GetHistoryAsync(new OrderHistoryFilter(Take: 20))];
    }

    private async Task SubmitOrderAsync()
    {
        _submitting = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_orderForm.ClientOrderId) || string.IsNullOrWhiteSpace(_orderForm.Symbol))
            {
                _orderMessage = "Client Order Id and Symbol are required.";
                _orderAccepted = false;
                return;
            }

            if (!Enum.TryParse<OrderSide>(_orderForm.Side, ignoreCase: true, out var side))
            {
                _orderMessage = $"Invalid side '{_orderForm.Side}'.";
                _orderAccepted = false;
                return;
            }

            if (_orderForm.Price <= 0 || _orderForm.Quantity <= 0)
            {
                _orderMessage = "Price and Quantity must be positive.";
                _orderAccepted = false;
                return;
            }

            var order = Order.CreateUserSubmitted(
                _orderForm.ClientOrderId, _orderForm.Symbol, side, OrderType.Limit,
                _orderForm.Price, _orderForm.Quantity, DateTimeOffset.UtcNow);

            var decision = await OrderSubmissionService.SubmitAsync(order);

            _orderAccepted = decision.Status == DecisionStatus.Accepted;
            _orderMessage = _orderAccepted
                ? $"Accepted - {order.ClientOrderId}"
                : $"Rejected - {string.Join("; ", decision.RejectionReasons)}";

            if (_orderAccepted)
            {
                _orderForm.ClientOrderId = OrderFormModel.NewClientOrderId();
            }

            await RefreshAsync();
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SaveRulesAsync()
    {
        _savingRules = true;
        try
        {
            var rules = _rulesForm.ToDomain();
            await TradingRulesRepository.SaveAsync(rules);
            _currentDeviationThreshold = rules.PriceDeviationThresholdPercent;
            _rulesMessage = $"Saved at {DateTimeOffset.UtcNow.UtcDateTime:HH:mm:ss} UTC.";
        }
        finally
        {
            _savingRules = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
        await Task.CompletedTask;
    }

    private sealed class OrderFormModel
    {
        public string ClientOrderId { get; set; } = NewClientOrderId();
        public string Symbol { get; set; } = "EURUSD";
        public string Side { get; set; } = "Buy";
        public decimal Price { get; set; }
        public decimal Quantity { get; set; } = 100m;

        public static string NewClientOrderId() => $"UI-{Guid.NewGuid():N}"[..8].ToUpperInvariant();
    }

    private sealed class RulesFormModel
    {
        public decimal MaxNotionalPerOrder { get; set; }
        public decimal MaxQuantityPerOrder { get; set; }
        public decimal PriceDeviationThresholdPercent { get; set; }
        public decimal AutoTradingSpreadPercentThreshold { get; set; }
        public bool DuplicateOrderIdCheckEnabled { get; set; }
        public bool SymbolWhitelistEnabled { get; set; }
        public string SymbolWhitelistCsv { get; set; } = "";

        public static RulesFormModel FromDomain(TradingRules rules) => new()
        {
            MaxNotionalPerOrder = rules.MaxNotionalPerOrder,
            MaxQuantityPerOrder = rules.MaxQuantityPerOrder,
            PriceDeviationThresholdPercent = rules.PriceDeviationThresholdPercent,
            AutoTradingSpreadPercentThreshold = rules.AutoTradingSpreadPercentThreshold,
            DuplicateOrderIdCheckEnabled = rules.DuplicateOrderIdCheckEnabled,
            SymbolWhitelistEnabled = rules.SymbolWhitelistEnabled,
            SymbolWhitelistCsv = string.Join(", ", rules.SymbolWhitelist),
        };

        public TradingRules ToDomain() => new()
        {
            MaxNotionalPerOrder = MaxNotionalPerOrder,
            MaxQuantityPerOrder = MaxQuantityPerOrder,
            PriceDeviationThresholdPercent = PriceDeviationThresholdPercent,
            AutoTradingSpreadPercentThreshold = AutoTradingSpreadPercentThreshold,
            DuplicateOrderIdCheckEnabled = DuplicateOrderIdCheckEnabled,
            SymbolWhitelistEnabled = SymbolWhitelistEnabled,
            SymbolWhitelist = SymbolWhitelistCsv
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList(),
            UpdatedAt = DateTimeOffset.UtcNow,
        };
    }
}
