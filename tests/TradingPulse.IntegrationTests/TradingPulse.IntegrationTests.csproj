  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TradingPulse.Domain\TradingPulse.Domain.csproj" />
    <ProjectReference Include="..\..\src\TradingPulse.Application\TradingPulse.Application.csproj" />
    <ProjectReference Include="..\..\src\TradingPulse.Infrastructure\TradingPulse.Infrastructure.csproj" />
  </ItemGroup>

</Project>
